# URL pública do site, usada em metadados/SEO (sitemap, Open Graph, canonical).
NEXT_PUBLIC_SITE_URL=https://seusite.com

# Opcionais — habilitam a seção "últimos vídeos" na Home via YouTube Data API.
# Sem essas duas variáveis, a seção usa o fallback gracioso (sem quebrar o build).
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
