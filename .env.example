# ─────────────────────────────────────────────────────────────────────
# Copie para .env.local (desenvolvimento) ou configure como variáveis
# no Railway (produção). NUNCA comite um .env de verdade — o .gitignore
# já bloqueia .env*, com exceção deste exemplo.
# ─────────────────────────────────────────────────────────────────────

# OBRIGATÓRIA em produção.
# URL pública do site, usada em canonical, hreflang, sitemap e Open Graph.
# Sem ela o build usa http://localhost:3000 e o SEO sai com links quebrados.
#
# ATENÇÃO: por ser NEXT_PUBLIC_*, é embutida no bundle em tempo de BUILD.
# Configure no Railway ANTES do primeiro deploy; mudar depois exige um
# novo build, não só um restart.
NEXT_PUBLIC_SITE_URL=https://seusite.com

# OPCIONAIS — a seção "últimos vídeos" e o contador de inscritos
# funcionam sem elas, lendo o feed RSS e a página pública do canal.
# Com a API key o site usa a API oficial do YouTube, que é mais estável.
#
# A key é lida só no servidor (Server Components), nunca chega ao
# navegador. Restrinja-a à YouTube Data API no Google Cloud Console.
YOUTUBE_API_KEY=
# ID do canal (começa com UC...). Sem isso, usa o canal padrão do código.
YOUTUBE_CHANNEL_ID=

# OPCIONAL — usuário do Medium de onde vêm os artigos.
# Sem isso, usa o usuário padrão definido em src/lib/medium.ts.
MEDIUM_USERNAME=aluiza.primo

# OPCIONAL — publicação do Substack usada pela newsletter e pelos posts.
# É o subdomínio: em aluizatech.substack.com, o valor é "aluizatech".
# Sem isso, usa o padrão definido em src/lib/substack.ts.
SUBSTACK_PUBLICATION=aluizatech
